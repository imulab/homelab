# Dockhand deployment inputs for the `strata-coding` stack.
#
# In Dockhand: stack name `strata-coding`, compose path
# `truenas/apps/strata-coding/compose.yaml`. Add every value below in the stack
# editor's environment-variable panel, then Deploy.
#
# The dataset creation commands, the model pre-seed downloads and the full
# rationale live in ../strata-daily/README.md - read that first. This stack
# shares the daily stack's /data layout, model tree and MTP layer, so switching
# profiles never re-downloads anything.
#
# NOTHING IN THIS STACK IS SECRET: leave every key-icon toggle OFF. Dockhand
# secrets vanish on a daemon-initiated restart; plain env vars survive.
#
# The SHARED values are duplicated here because Dockhand stores env vars per
# stack - the two stacks do not share them. Keep this panel in step with
# ../strata-daily/.env.example.

# ---------------------------------------------------------------------------
# Image build  (SHARED - must match strata-daily)
# ---------------------------------------------------------------------------

# Check https://github.com/Niko1221/Strata/releases. setup.py enforces
# MIN_ENGINE = 0.1.40.2. Keep identical to the daily stack: both build the
# same `strata-hip:local` image from the same Dockerfile, so a mismatch means
# whichever stack deployed last decides what runs.
STRATA_REF=v0.1.41
STRATA_HIP_ARCH=gfx1201
STRATA_BUILD_VISION=cpu

# ---------------------------------------------------------------------------
# GPU devices  (SHARED - must match strata-daily)
# ---------------------------------------------------------------------------

# Verify on the box: stat -c '%n gid=%g' /dev/kfd /dev/dri/renderD*
STRATA_RENDER_GID=107

# ---------------------------------------------------------------------------
# Storage  (SHARED - must match strata-daily)
# ---------------------------------------------------------------------------

STRATA_DATA_PATH=/mnt/puddle/apps/strata
STRATA_MODELS_PATH=/mnt/cistern/apps/strata/models

# ---------------------------------------------------------------------------
# Access  (SHARED - must match strata-daily)
# ---------------------------------------------------------------------------

# Caddy serves https://strata-coding.absurdlab.dev over the proxy network; add
# that hostname to the photonicat dnsmasq entries and refresh Passwall's DNS
# per apps/README.md.
STRATA_BIND_ADDRESS=192.168.20.11

# Same host port as the daily stack on purpose: only one profile runs at a
# time, and a mistaken co-start then fails on the bind rather than fighting for
# VRAM. NOT 8080 - the TrueNAS web UI owns that. See strata-daily/.env.example
# for why it is 27182.
STRATA_PUBLISHED_PORT=27182

# ---------------------------------------------------------------------------
# Coding profile model
# ---------------------------------------------------------------------------

# The Coder keeps 256 of each layer's 512 experts, chosen on code data (91% of
# the full model's SWE-bench Verified, 99% of LiveCodeBench). Its 23 GB of
# experts fit ENTIRELY in the 32 GB card, so decode barely touches the CPU
# pool - which matters most on this Zen 1 host, where per-core throughput is
# the weak link. It is weaker outside code and in non-English languages, which
# is exactly why it is a separate profile and not the daily driver.
STRATA_CODING_FAMILY=coder
STRATA_CODING_MODEL=IQ1_M

# 128K: agentic coding harnesses legitimately need long context and compact
# before hitting the ceiling. The Coder's experts all fit VRAM, so KV is not
# competing with the expert cache the way it is in the daily profile. 262144
# is available on this host's RAM if a repo genuinely needs it.
STRATA_CODING_CONTEXT=131072

# k8v4 is the one documented tuning win for this exact case - a Coder at long
# context, measured at 99 instead of 85 tok/s output for a 2-5% prefill cost,
# with the same needle results.
STRATA_CODING_KV=k8v4

# The coding profile gets vision too: free on the GPU (CPU encoder), so it
# avoids reconfiguring the model later if you want to hand it a screenshot.
# Set "no" to drop the encoder from this model's config.
STRATA_CODING_VISION=cpu

# The Coder plans ~33 GB (23 GB experts plus ~10 GB). Hard cap, same reasoning
# as the daily stack.
STRATA_CODING_MEM_LIMIT=48g

# ---------------------------------------------------------------------------
# Misc  (SHARED - must match strata-daily)
# ---------------------------------------------------------------------------

TZ=Asia/Shanghai
