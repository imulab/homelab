# Dockhand deployment inputs for the `hermes` stack.
#
# In Dockhand: stack name `hermes`, compose path `truenas/apps/hermes/compose.yaml`.
# Set these values in the Stack editor env-var panel.
#
# Model, email, and other agent settings are not deployment inputs. Configure
# them in the Hermes app after the first Deploy. They are stored in the mounted
# /opt/data volume (config.yaml and .env). Nothing needs to be seeded there.

# ---- Non-secret values ------------------------------------------------------

# Host bind address for the direct LAN fallback ports (dashboard 9119, API 8642).
HERMES_BIND_ADDRESS=192.168.20.11

# Absolute host path for the Hermes state volume. Create it first:
#   zfs create -p puddle/apps/hermes/data
#   (ownership: the image runs the gateway as UID 10000, `hermes` - see README.md)
HERMES_DATA_PATH=/mnt/puddle/apps/hermes/data

# Dashboard basic-auth username (non-secret).
HERMES_DASHBOARD_USERNAME=operator

# Optional CORS origins for the API server. Leave empty, or a comma-separated list.
HERMES_API_CORS_ORIGINS=

TZ=Asia/Shanghai

# ---- Secrets (key-icon in the Dockhand panel) -------------------------------
#
# Required before the first Deploy. Generate each:
#   openssl rand -base64 24   # dashboard password
#   openssl rand -base64 32   # dashboard session secret (32+ bytes)
#   openssl rand -hex 32      # API server key (16+ chars)
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
API_SERVER_KEY=

# The Strata API key is entered in the app's model setup and stored in
# /opt/data/.env. Do not add it here.
#
# If the old EMAIL_* rows are still in this stack's Dockhand env panel, remove
# them. Email credentials now come from /opt/data/.env, written by the
# dashboard Channels page.
