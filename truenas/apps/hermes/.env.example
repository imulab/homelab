# Dockhand deployment inputs for the `hermes` stack.
#
# In Dockhand: stack name `hermes`, compose path `truenas/apps/hermes/compose.yaml`.
# Add the NON-SECRET values below in the Stack editor env-var panel.
#
# SECRETS ARE DELIBERATELY NOT IN THIS FILE'S DOCKHAND PANEL. Hermes reads its
# secrets from /opt/data/.env (the mounted volume), so email credentials and
# API keys survive a daemon-initiated restart. Dockhand key-icon secrets do not
# (decision #8 in truenas/apps/README.md). Seed /opt/data/.env by hand per
# README.md before the first Deploy.

# ---- Dockhand env (non-secret) ----------------------------------------------

# Host bind address for the direct LAN fallback ports (dashboard 9119, API 8642).
HERMES_BIND_ADDRESS=192.168.20.11

# Absolute host path for the Hermes state volume. Create it first:
#   zfs create -p puddle/apps/hermes/data
#   (ownership: the official image runs as the non-root `hermes` user, UID/GID
#   must match on first start - see README.md)
HERMES_DATA_PATH=/mnt/puddle/apps/hermes/data

# Dashboard basic-auth username (non-secret). The password is a secret and
# lives in /opt/data/.env as HERMES_DASHBOARD_BASIC_AUTH_PASSWORD.
HERMES_DASHBOARD_USERNAME=operator

# Optional: CORS origins for the API server. Leave empty (comma-separated list).
HERMES_API_CORS_ORIGINS=

TZ=Asia/Shanghai

# ---- /opt/data/.env secrets (seed by hand, NOT in the Dockhand panel) -------

# The dedicated agent mailbox on iCloud+ custom domain (absurdlab.dev).
#   EMAIL_ADDRESS=hermes@absurdlab.dev
#   EMAIL_PASSWORD=<iCloud app-specific password, NOT your Apple ID password>
#   EMAIL_IMAP_HOST=imap.mail.me.com
#   EMAIL_SMTP_HOST=smtp.mail.me.com
#   EMAIL_IMAP_PORT=993
#   EMAIL_SMTP_PORT=587
#   EMAIL_POLL_INTERVAL=15
#   EMAIL_AUTHSERV_ID=            # unset for iCloud (plain app-password auth);
#                                 # only Gmail OAuth needs mx.google.com - verify
#   EMAIL_ALLOWED_USERS=<your email>       # the reach gate; comma-separated
#   EMAIL_HOME_ADDRESS=hermes@absurdlab.dev  # optional, verify

# Gateway API + dashboard secrets.
#   API_SERVER_KEY=<openssl rand -hex 32>          # required for :8642 on LAN
#   HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<pw>
#   HERMES_DASHBOARD_BASIC_AUTH_SECRET=<openssl rand -hex 32>  # restart-stable sessions

# NOTE: verify at bring-up whether Hermes reads these three from /opt/data/.env
# or requires them as process env. If process env is required, set them as PLAIN
# env in the Dockhand panel (never the key-icon toggle) and expect a manual
# redeploy after a host reboot (decision #8).
