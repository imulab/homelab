# Dockhand deployment inputs for the `immich` stack.
#
# In Dockhand, use stack name `immich` and compose path
# `truenas/apps/immich/compose.yaml`. Add every value below in the stack
# editor's environment-variable panel. Only DB_PASSWORD is secret: set its
# value and turn the key-icon toggle ON. Do not commit a real .env.

# Exact pin (decision: ticket 10). Upgrades: read release notes, bump this,
# Deploy; upgrade phone apps before the server. The -openvino ML image follows
# this pin automatically.
IMMICH_VERSION=v3.1.0

# Dedicated non-login TrueNAS service identity (decision 09; next after
# Jellyfin's 3001). Pre-deploy: chown the writable roots below to 3002:3002.
IMMICH_UID=3002
IMMICH_GID=3002

# Intel Arc A380 device nodes and the host render group's numeric GID, same
# values as the jellyfin stack (stat -c '%g' /dev/dri/renderD128).
IMMICH_CARD_DEVICE=/dev/dri/card1
IMMICH_RENDER_DEVICE=/dev/dri/renderD128
IMMICH_RENDER_GID=107

# Irreplaceable originals on the essentials tree (decision 09); inherits the
# existing snapshot + replication protection on that tree.
UPLOAD_LOCATION=/mnt/puddle/essentials/media/family/immich

# Regenerable derivatives on the disposable cache dataset (120 GB refquota).
THUMBS_PATH=/mnt/puddle/apps/immich/cache/thumbs
ENCODED_VIDEO_PATH=/mnt/puddle/apps/immich/cache/encoded-video
MODEL_CACHE_PATH=/mnt/puddle/apps/immich/cache/model-cache

# Durable app-side state on the config dataset. The built-in daily pg_dump
# backups under BACKUP_PATH are the DB restore point under our storage split.
PROFILE_PATH=/mnt/puddle/apps/immich/config/profile
BACKUP_PATH=/mnt/puddle/apps/immich/config/backups
DB_DATA_LOCATION=/mnt/puddle/apps/immich/config/pgdata

# Direct fallback access on the TrueNAS LAN (Jellyfin pattern). Caddy
# separately serves the canonical https://immich.absurdlab.dev route over the
# external proxy network; immich.absurdlab.dev resolves only via the photonicat
# dnsmasq hijack (decision 01: LAN-only, remote rides tailnet roam-back).
IMMICH_BIND_ADDRESS=192.168.20.11
IMMICH_PUBLISHED_PORT=2283

# Postgres locals; defaults match upstream. DB_PASSWORD: random, letters and
# digits only (A-Za-z0-9) per Immich docs, SECRET in Dockhand. Post-reboot
# caveat (apps decision #8): after a daemon-initiated restart the containers
# come up without it; redeploy the stack from Dockhand to re-inject.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=

# Trust the docker bridge pools so Immich logs real client IPs behind Caddy.
IMMICH_TRUSTED_PROXIES=172.16.0.0/12

# Match the box timezone.
TZ=Asia/Shanghai
