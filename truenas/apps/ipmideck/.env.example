# Dockhand deployment inputs for the `ipmideck` stack.
#
# In Dockhand, use stack name `ipmideck` and compose path
# `truenas/apps/ipmideck/compose.yaml`. Add every value below in the stack
# editor's environment-variable panel. Nothing in this stack is secret:
# leave every key-icon toggle OFF. Do not commit a real .env.

# Dedicated non-login TrueNAS service identity (house identity pattern;
# 3001 jellyfin, 3002 immich, 3003 ipmideck). Pre-deploy: the dataset
# puddle/apps/ipmideck/data was created and chowned 3003:3003 by hand.
IPMIDECK_UID=3003
IPMIDECK_GID=3003

# Durable app state on the apps dataset: config.yaml, sensor history, and
# the AES key that encrypts stored BMC credentials. Losing the key only
# invalidates the stored credentials (re-add the BMCs in the wizard), but
# keep the dataset in the apps-tree snapshots anyway.
IPMIDECK_DATA_PATH=/mnt/puddle/apps/ipmideck/data

# Direct fallback access on the TrueNAS LAN (Jellyfin pattern). 6233 is a
# deliberate pick: mnemonic for IPMI's UDP 623, and outside the well-known
# dev-webapp ports. Caddy separately serves the canonical
# https://ipmideck.absurdlab.dev route over the external proxy network;
# the hostname resolves only via the photonicat dnsmasq hijack. After
# adding the dnsmasq entry, refresh Passwall's DNS per apps/README.md.
IPMIDECK_BIND_ADDRESS=192.168.20.11
IPMIDECK_PUBLISHED_PORT=6233

# Match the box timezone.
TZ=Asia/Shanghai
