# Dockhand deployment inputs for the `comfyui` stack.
#
# In Dockhand, use stack name `comfyui` and compose path
# `truenas/apps/comfyui/compose.yaml`. Add every value below in the stack
# editor's environment-variable panel. Nothing in this stack is secret:
# leave every key-icon toggle OFF. Do not commit a real .env.
#
# Host gate (blocks deploy): the R9700 (gfx1201) needs amdgpu/KFD compute
# from Linux 6.14+, i.e. the TrueNAS 26 line. As of 2026-10-05 the box
# reports 6.12.95-production+truenas (25.10 line), which predates RDNA4
# compute; SCALE does not support out-of-tree amdgpu-dkms. Upgrade to
# TrueNAS 26 and confirm "gfx1201" in rocminfo output before deploying.

# R9700 render node via the stable PCI by-path symlink. renderD numbering
# can shift when GPUs change; by-path encodes the PCI address instead.
# Find it with (match the R9700's PCI address from lspci):
#   lspci -D | grep -iE 'vga|3d|display'
#   ls -l /dev/dri/by-path/
#   grep -H PCI_SLOT_NAME /sys/class/dri/*/device/uevent
# Docker resolves the symlink at container create; inside the container it
# appears as /dev/dri/renderD128 regardless.
COMFYUI_RENDER_DEVICE=/dev/dri/by-path/pci-0000:21:00.0-render

# Numeric GID of the host render group, which owns both /dev/kfd and the
# render node (root:render, mode 660). Verify with:
#   stat -c '%n gid=%g' /dev/kfd /dev/dri/renderD*
COMFYUI_RENDER_GID=107

# Dataset binds under the single puddle/apps/comfyui dataset. Created by
# hand pre-deploy: zfs create puddle/apps/comfyui, then mkdir models input
# output custom_nodes user cache. All stay root-owned (image runs as root).
COMFYUI_MODELS_PATH=/mnt/puddle/apps/comfyui/models
COMFYUI_INPUT_PATH=/mnt/puddle/apps/comfyui/input
COMFYUI_OUTPUT_PATH=/mnt/puddle/apps/comfyui/output
COMFYUI_CUSTOM_NODES_PATH=/mnt/puddle/apps/comfyui/custom_nodes
COMFYUI_USER_PATH=/mnt/puddle/apps/comfyui/user
COMFYUI_CACHE_PATH=/mnt/puddle/apps/comfyui/cache

# Direct fallback access on the TrueNAS LAN (Jellyfin/IPMIDeck pattern).
# Caddy separately serves the canonical https://comfy.absurdlab.dev route
# over the external proxy network; the hostname resolves only via the
# photonicat dnsmasq hijack. After adding the dnsmasq entry, refresh
# Passwall's DNS per apps/README.md.
COMFYUI_BIND_ADDRESS=192.168.20.11
COMFYUI_PUBLISHED_PORT=8188

# ComfyUI server args appended to the entrypoint's fixed
# --listen --port 8188. The compose file already defaults to the RDNA4
# community-stable tuning (YanWenKun/ComfyUI-Docker #171:
# --disable-smart-memory avoids smart offload stalls,
# --use-pytorch-cross-attention picks SDPA on ROCm), so this entry stays
# commented out: the compose default is the single source of truth.
# Uncomment and edit only to change the tuning from Dockhand.
#COMFYUI_CLI_ARGS=--disable-smart-memory --use-pytorch-cross-attention

# Match the box timezone.
TZ=Asia/Shanghai
