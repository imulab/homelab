# Dockhand deployment inputs for the `jellyfin` stack.
#
# In Dockhand, use stack name `jellyfin` and compose path
# `truenas/apps/jellyfin/compose.yaml`. Add every value below in the stack
# editor's environment-variable panel. These values are host-specific but not
# secret, so leave the key-icon secret toggle off. Do not commit a real .env.

# Dedicated non-login TrueNAS service identity.
JELLYFIN_UID=3001
JELLYFIN_GID=3001

# Intel Arc A380 device nodes and the host render group's numeric GID.
JELLYFIN_CARD_DEVICE=/dev/dri/card1
JELLYFIN_RENDER_DEVICE=/dev/dri/renderD128
JELLYFIN_RENDER_GID=107

# Writable application datasets. Config is durable; cache and transcode are
# disposable. The transcode dataset has a 120 GB dataset-only refquota.
JELLYFIN_CONFIG_PATH=/mnt/puddle/apps/jellyfin/config
JELLYFIN_CACHE_PATH=/mnt/puddle/apps/jellyfin/cache
JELLYFIN_TRANSCODE_PATH=/mnt/puddle/apps/jellyfin/transcode

# Read-only media sources.
MOVIES_ESSENTIALS_PATH=/mnt/puddle/essentials/media/movie
MOVIES_EPHEMERAL_PATH=/mnt/puddle/ephemeral/media/movie
TV_ESSENTIALS_PATH=/mnt/puddle/essentials/media/tv
TV_EPHEMERAL_PATH=/mnt/puddle/ephemeral/media/tv
FAMILY_CLIPS_PATH=/mnt/puddle/essentials/media/family/clips
FAMILY_PHOTOS_PATH=/mnt/puddle/essentials/media/family/photos

# Direct fallback access on the TrueNAS LAN. Caddy separately serves the
# canonical https://media.absurdlab.dev route over the external proxy network.
JELLYFIN_BIND_ADDRESS=192.168.20.11
JELLYFIN_PUBLISHED_PORT=8096
