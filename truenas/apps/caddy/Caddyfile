# Global Caddy config. caddy-docker-proxy (started via `caddy docker-proxy` in
# the Dockerfile CMD) reads container labels and auto-generates per-site route
# blocks, which Caddy merges with the global options below.

{
	# Optional: email Let's Encrypt associates with your account (for expiry
	# notices). Caddy works without it. To enable, uncomment and set the
	# LETSENCRYPT_EMAIL env var in Dockhand's stack env-var panel.
	# email {$LETSENCRYPT_EMAIL}

	# Default ACME challenge for all sites: Cloudflare DNS-01. Every
	# label-generated site (e.g. index.absurdlab.dev) inherits this and gets
	# automatic HTTPS via Cloudflare. Note: this means per-subdomain issuance,
	# not a single wildcard cert — caddy-docker-proxy generates one site block
	# per labeled domain. Acceptable at homelab scale; revisit if rate limits
	# bite. See decision #4 for the original (wildcard) intent.
	acme_dns cloudflare {$CF_API_TOKEN}
}
