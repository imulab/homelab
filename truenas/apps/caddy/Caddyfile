# Seed/global Caddy config. caddy-docker-proxy imports this file and appends
# auto-generated routes from container labels at runtime.
#
# The wildcard + apex cert is issued once via Cloudflare DNS-01 (decision #4).

{
	# Optional: email Let's Encrypt associates with your account (for expiry
	# notices). Caddy works without it. To enable, uncomment and set the
	# LETSENCRYPT_EMAIL env var in Dockhand's stack env-var panel.
	# email {$LETSENCRYPT_EMAIL}

	# Issue a single cert covering the wildcard + apex via Cloudflare DNS-01.
	acme_dns cloudflare {$CF_API_TOKEN}
}

# caddy-docker-proxy auto-merges backend routes below this point from labels
# like: caddy=index.absurdlab.dev, caddy.reverse_proxy="{{upstreams}}".
