# Cloudflare API token used by Caddy for DNS-01 ACME challenges.
# Required. Set the value in Dockhand's Stack editor env-var panel and toggle
# the key icon to mark it secret. Do NOT put the real value in this file or in
# any committed .env — see decision #8.
CF_API_TOKEN=set-in-dockhand-stack-env-as-secret

# Optional: email for Let's Encrypt notifications. Set in Dockhand if you want
# the Caddyfile's placeholder filled in; not required for a prototype.
# LETSENCRYPT_EMAIL=you@example.com
