# Dockhand deployment inputs for the `strata` stack.
#
# In Dockhand: stack name `strata`, compose path
# `truenas/apps/strata/compose.yaml`. Add every value below in the stack
# editor's environment-variable panel, then Deploy.
#
# NOTHING IN THIS STACK IS SECRET: leave every key-icon toggle OFF. Dockhand
# injects secrets at deploy time and documents that they vanish on a
# daemon-initiated restart. This stack is restart: unless-stopped, so it comes
# back on its own after a reboot - a secret-based value would silently
# disappear exactly then, leaving an endpoint that looks healthy but is
# unauthenticated. Plain env vars are baked into the container at create time
# and survive. Same reasoning as the comfyui stack.
#
# Kernel note: this stack needs the TrueNAS 26 kernel (6.18). The 25.10 kernel
# (6.12.95) enumerated gfx1201 but wedged on first GPU context (gfx ring test
# -110, "MES ring buffer is full"); the box was upgraded to 26-Beta3 on
# 2026-10-06 and works. Same gate as comfyui.
#
# GPU co-tenancy: no VRAM isolation between ROCm processes. `strata` and
# `comfyui` are mutually exclusive - stop one in Dockhand before starting the
# other.

# ---------------------------------------------------------------------------
# Image build
# ---------------------------------------------------------------------------

# Required, no default. The Strata release tag or commit the engine is built
# from at image build time. Check:
#   https://github.com/Niko1221/Strata/releases
# setup.py enforces MIN_ENGINE, which is 0.1.41 at this ref, so an older ref is
# refused at start. Bumping this is a rebuild: open the stack in Dockhand and
# Deploy with "build images" enabled.
#
# v0.1.41 vs newer: 0.1.43 turns the RDNA4 prompt-path defaults on by itself
# (route tail skip, the measured PCIe share, 16K prompt chunks, fused IQ3
# prompt experts). On 0.1.41 those are either absent or opt-in, which is why
# the two STRATA_* tuning switches below exist. Upgrading is a tested follow-up
# once you have a baseline of your own - see README section 6.
STRATA_REF=v0.1.41

# Target GPU architecture. gfx1201 is the Radeon AI PRO R9700 (RDNA4).
STRATA_HIP_ARCH=gfx1201

# cpu | none. "cpu" builds the image encoder that runs on the CPU - the AMD
# backend has no GPU image encoder, so this is the only vision path on this
# card. Unlike the NVIDIA path (which reserves VRAM and evicts expert slots,
# costing 2-8% on text), the CPU encoder costs NOTHING on the GPU, so vision
# does not slow text down here. Keep the image encoder built: the runtime
# VISION knob below is separate and reversible, but this one is a rebuild.
STRATA_BUILD_VISION=cpu

# ---------------------------------------------------------------------------
# GPU devices
# ---------------------------------------------------------------------------

# Numeric GID of the host render group, which owns both /dev/kfd and the
# render nodes (root:render, mode 660). Verify on the box:
#   stat -c '%n gid=%g' /dev/kfd /dev/dri/renderD*
# Devices need no env vars: compose maps the whole /dev/dri directory plus
# /dev/kfd directly.
STRATA_RENDER_GID=107

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# /data root: config, packs and the MTP draft layer. Lives on puddle and is
# the part worth snapshotting. Created pre-deploy:
#   zfs create -p puddle/apps/strata
#   mkdir -p /mnt/puddle/apps/strata/config
STRATA_DATA_PATH=/mnt/puddle/apps/strata

# The model shards and mmproj files, overlaid onto /data/models from the
# Optane 900P pool. This is the ONE directory that must be on flash: shard 2
# (the -00002-of-00002.gguf, a 38.8 GB n-gram/PLE lookup table) is read from
# disk during inference, not loaded into RAM. Everything else in /data is read
# once at startup into RAM. Created pre-deploy:
#   zpool create -o ashift=12 cistern /dev/disk/by-id/<optane-900p-id>
#   zfs create -p -o recordsize=1m -o atime=off cistern/apps/strata/models
#
# If this path is on a rotational disk instead, setup.py detects it and either
# warns that random n-gram reads "can stall prompts for minutes", or moves the
# whole table into RAM with --ple-io ram when the RAM allows.
STRATA_MODELS_PATH=/mnt/cistern/apps/strata/models

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# Direct LAN fallback (Jellyfin/IPMIDeck/ComfyUI pattern). Caddy separately
# serves the canonical route over the external proxy network:
#   https://strata.absurdlab.dev
# which resolves only via the photonicat dnsmasq hijack. Add the hostname in
# Network -> DHCP and DNS -> Hostnames, then refresh Passwall's DNS per
# apps/README.md.
STRATA_BIND_ADDRESS=192.168.20.11

# Host port for the direct LAN fallback. NOT 8080: the TrueNAS web UI already
# owns host 8080 on this box (see dashy/conf.yml, "TrueNAS web UI over HTTP")
# and Caddy holds 80/443. Strata's container port stays 8080 regardless.
# 27182 chosen deliberately: it is below Linux's ephemeral port range
# (32768-60999, see net.ipv4.ip_local_port_range), so Docker's bind can never
# race a transient outbound allocation and fail intermittently at start, and it
# is far from every port in use on this box (8080, 8443, 8096, 2283, 6233,
# 8188, 30328) so a range scan will not stumble onto it.
# Verify before deploying:  ss -lntp | grep -E ':(8080|27182)\b'
STRATA_PUBLISHED_PORT=27182

# No API key here on purpose: the endpoint is bound to the LAN and reached
# over the proxy network, so network placement is the control. If you ever
# expose it beyond the LAN, add API_KEY=<value> to the compose environment as
# a PLAIN env var (not a Dockhand secret - see the header note).

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Swift 1.5 IQ3_XXS is the generalist. Why this and not the other tiers, in
# one line each:
#   * IQ3_XXS over IQ2_XS: the 2-bit tier is repeatedly reported to erode
#     instruction-following, format stability and stopping behaviour before it
#     erodes reasoning, and those are exactly the failure modes of an
#     execution-only coding delegation. Costs ~10-17% decode and ~7.4 GB more
#     RAM; prefill measured at parity.
#   * Swift 1.5 over the base model: 63% fewer thinking tokens for <1% accuracy
#     loss, which suits execution-only work. Its own licence applies (see its
#     HF page); FAMILY=qwen gives the Apache-2.0 base at the same tier.
#   * IQ3_XXS over IQ3_S: at v0.1.41 Swift has no IQ3_S - it is restricted to
#     families ("qwen",). IQ3_S arrives for Swift in a later engine ref and
#     needs an engine bump.
# Full tables and sources: README section "Model choice".
STRATA_FAMILY=swift
STRATA_MODEL=IQ3_XXS

# 262144 is the model's native trained ceiling (no rope scaling needed). From
# 64K up setup.py enables KV streaming automatically: the KV cache lives in
# RAM and only the attended 32K window in VRAM, which frees VRAM for expert
# slots. Decode is flat in context (the GDN linear attention is O(1) per
# token), so a long context costs time-to-first-token on fresh prompts, not
# decode throughput. Setup accepts 8K-524288.
STRATA_CONTEXT=262144

# int8 is setup's default, the safest, and REQUIRED by STRATA_HIP_WMMA below.
# k8v4 uses 23% less KV but scores worse than 8-bit on long documents; q4_0
# halves the KV but costs 8-12% perplexity on long documents. Keep int8.
STRATA_KV=int8

# cpu | no. "cpu" = images work, encoded on the CPU. "no" removes image input
# entirely - it is NOT a switch that hands vision to the CPU, that IS cpu.
# Vision is kept for OCR and for indexing the NAS video vault; UniFi camera
# streams are handled by the UniFi AI Key, so no min_tokens tuning is needed
# here. Setting "no" buys back the 700 MiB VRAM reserve (~2% decode) at the
# cost of all image input. Changing this needs REINSTALL=1.
STRATA_VISION=cpu

# off | auto | on. Deliberately OFF. setup.py reads the HOST's /proc/meminfo
# (128 GiB), not the container's cap, so it would never choose low-RAM mode on
# this box; there is no cgroup-aware path. Low-RAM mode would map the experts
# from the pack file instead of holding them in the pinned RAM arena, which is
# slower and pointless here: the arena fits inside the 64g cap with room to
# spare. See the mem_limit note in compose.yaml.
STRATA_LOW_RAM=off

# ---------------------------------------------------------------------------
# Engine tuning (see README section 6)
# ---------------------------------------------------------------------------

# RDNA4 matrix-core prompt attention. ON by default: measured on this exact
# card at this ref at 7.2-7.5x the portable kernel (4K prompts 1,784 -> 2,427
# tok/s; 16K 1,797 -> 2,700). Requires KV=int8. Not bitwise - greedy text can
# diverge from ~token 50 - and it pairs with a 96-slot prompt expert ring in
# place of 384. Accuracy measured within noise. Set 0 to A/B or to silence the
# startup hint.
STRATA_HIP_WMMA=1

# Fused int8 prompt-expert kernels. LEFT EMPTY on purpose - unverified at this
# ref. The kernel is gated on a CUDA compute-capability check (cc >= 80) that
# may not open on gfx1201 at v0.1.41, so the advertised +15-20% prompt gain
# cannot be assumed. Set to 1 to test it: the engine prints a banner at the
# first prompt when the kernels actually take effect, and the README has the
# grep and the caveat. Later refs enable this on RDNA4 by default.
STRATA_PF_FUSED=

# HARD RAM cap. setup.py reads the HOST's /proc/meminfo (128 GB), not this cap,
# so the cap must EXCEED what setup plans or setup configures a full-RAM layout
# that the cap then OOM-kills. IQ3_XXS plans ~42.9 GB of experts plus ~10 GB of
# dense weights/engine, plus ~3.6 GB of streamed KV at 256K: ~57 GB, so 64g
# leaves headroom and still leaves ~64 GB of the host for TrueNAS, ZFS ARC and
# the other stacks. Do not convert this to a soft limit.
STRATA_MEM_LIMIT=64g

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Match the box timezone.
TZ=Asia/Shanghai
