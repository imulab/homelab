# Dockhand deployment inputs for the `strata` stack (Strata 0.2.17, engine
# 0.1.63).
#
# In Dockhand: stack name `strata`, compose path
# `truenas/apps/strata/compose.yaml`. Every value below goes in the stack
# editor's environment-variable panel, then Deploy.
#
# THE API KEY IS ACCESS CONTROL AND IT IS MANDATORY. 0.2.x refuses a
# non-loopback bind without one, and every /v1 request must carry
# `Authorization: Bearer <key>`. Only GET /health answers without it. Keep the
# key-icon toggle OFF for it: Dockhand injects secrets at deploy time and they
# do not survive a daemon-initiated restart, while this stack is
# restart: unless-stopped. A plain env var is baked into the container at
# create time and survives.
#
# A key also switches the old DNS-rebinding Host check off entirely, so
# STRATA_ALLOWED_HOSTS is gone from this stack. The key is the only control.
#
# Kernel note: needs the TrueNAS 26 kernel (6.18). The 25.10 kernel enumerated
# gfx1201 but wedged on the first GPU context (gfx ring test -110, "MES ring
# buffer is full"). Same gate as comfyui.
#
# GPU co-tenancy: no VRAM isolation between ROCm processes. `strata` and
# `comfyui` are mutually exclusive. Stop one in Dockhand before starting the
# other.
#
# Upgrade note: 0.2.x keeps its files under /data/Strata-data. On first start
# it moves the old /data/models, /data/packs and /data/mtp there. The old
# /data/config is not read and the run settings are made again from the files.
# Model shards mounted through STRATA_MODELS_PATH are left alone and are not
# moved.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------

# Pinned on purpose. `latest-rocm-gfx120x` exists and would drift. Check
# https://github.com/Niko1221/Strata/releases before bumping.
#
# 0.2.x publishes ready-made images from the engine package of each release, so
# the image already contains the engine and the Terminal. There is no compile
# at deploy time. 0.2.17 is the current release; its engine is 0.1.63.
STRATA_IMAGE_TAG=0.2.17-rocm-gfx120x

# ---------------------------------------------------------------------------
# GPU devices
# ---------------------------------------------------------------------------

# Numeric GID of the host render group, which owns both /dev/kfd and the
# render nodes (root:render, mode 660). Verify on the box:
#   stat -c '%n gid=%g' /dev/kfd /dev/dri/renderD*
# Devices need no env vars: compose maps the whole /dev/dri directory plus
# /dev/kfd directly.
STRATA_RENDER_GID=107

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# /data root: Strata-data (model files, prepared pack), state (presets,
# tuning, API key), install (run settings, logs) and home. Lives on puddle and
# is the part worth snapshotting. Created pre-deploy:
#   zfs create -p puddle/apps/strata
STRATA_DATA_PATH=/mnt/puddle/apps/strata

# Model shards, read-only, from the Optane 900P. The engine copies the experts
# and the n-gram table into RAM at start, so this mount only decides cold-start
# time. Keep it on flash: a cold start reads the 44.9 GB expert shard and the
# 38.8 GB n-gram shard once.
STRATA_MODELS_PATH=/mnt/cistern/apps/strata/models

# The folder inside the container that holds the shards of the selected model
# directly: the Optane pre-seed of the abliterated (uncensored) Swift 1.5 build.
#   /mnt/cistern/apps/strata/models/sc117-swift-IQ3_S/
#   ├── Swift-Qwen3.8-Flash-Next-GSQ-RCO-abliterated-IQ3_S-00001-of-00002.gguf  44.85 GB
#   ├── Swift-Qwen3.8-Flash-Next-GSQ-RCO-abliterated-IQ3_S-00002-of-00002.gguf  38.70 GB
#   └── mmproj-Swift-Qwen3.8-Flash-Next-BF16.gguf                                0.9 GB
# The mmproj next to the shards is the picture reader, so VISION=on needs no
# download. A cold start reads 83.5 GB from the Optane in about a minute.
# Runtime speed does not depend on it, because the engine copies the experts
# and the n-gram table into RAM at start.
#
# The pre-seed is pinned to Hugging Face revision
# 3db919a964b1f0ae0d1000ba7be90b3e38b1f7a3. The README has the download
# commands and the expected sizes.
#
# The start log reports the size/SHA difference from the official Swift 1.5
# files and uses these files anyway, because they are complete GGUF files
# ("another version or a fine-tune"). That is expected for this build.
#
# Set this to /models/swift-IQ3_S to go back to the censored upstream shards.
#
# Empty means the container downloads the model into /data/Strata-data on
# first start instead, about 89.7 GB with the drafter and the reader, which the
# image's 2 hour health window covers. `docker ps` shows "starting".
STRATA_MODEL_PATH=/models/sc117-swift-IQ3_S

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# Direct LAN fallback. Caddy separately serves the canonical hostname over the
# external proxy network.
STRATA_BIND_ADDRESS=192.168.20.11

# Host port for the direct LAN fallback. NOT 8080: the TrueNAS web UI owns host
# 8080 on this box and Caddy holds 80/443. The container port stays 8080.
# 27182 is below Linux's ephemeral range (32768-60999), so Docker's bind cannot
# race a transient outbound allocation.
STRATA_PUBLISHED_PORT=27182

# Hostname Caddy serves. Caddy injects the Authorization header for it, because
# the web UI shares the API's origin and its own /v1 calls would otherwise 401.
STRATA_HOSTNAME=strata.absurdlab.dev

# REQUIRED. 16 characters or more, and use hex so the Caddyfile stays simple:
#   openssl rand -hex 24
# Plain env var, never the key-icon secret toggle. Caddy injects it for the
# hostname route. Direct LAN clients and any other caller must send
#   Authorization: Bearer <key>
# and only GET /health is open without it.
#
# Hermes reaches Strata container-to-container at http://strata:8080/v1. If
# Hermes is re-enabled, its model config needs the same key in `api_key`, or
# every request gets a 401.
STRATA_API_KEY=

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# IQ3_S is the quality tier: upstream calls it "best; matches the full model on
# the published tests". It costs roughly 13% decode against IQ3_XXS (RTX 5070
# table, 61.6 -> 53.3 tok/s) and about 50 GB of experts.
#
# The 256 GB upgrade (251 GiB usable) removed the old memory ceiling. It did not make decode
# faster: decode is bounded by the 32 GB VRAM expert cache and the CPU, and a
# bigger quant holds fewer experts in VRAM. Q8_0 would now fit in RAM (~136 GB)
# but is slower again and needs a 188 GB download.
#
# Swift 1.5 is kept over the base model: it thinks shorter, which suits the
# generalist plus execution-only coding delegation role. Its own licence
# applies.
STRATA_FAMILY=swift
STRATA_MODEL=IQ3_S

# 262144 is the model's native trained ceiling, so no rope scaling is needed.
# From 64K up the engine streams the KV cache: the whole cache lives in RAM
# and only the attended window sits in VRAM, which frees VRAM for experts.
STRATA_CONTEXT=262144

# int8 is the setup default, the safest, and REQUIRED by STRATA_HIP_WMMA (the
# gfx12 matrix-core prompt attention). k8v4 uses less memory and is slightly
# less precise on long documents; q4_0 halves the KV at 8-12% perplexity cost.
STRATA_KV=int8

# on | off | gpu | cpu. "on" uses the card's reader from 24 GB of VRAM: about
# 1.4 GiB of VRAM and 0.1 to 0.5 s per picture, against seconds per picture on
# the CPU reader. Vision stays for OCR and NAS video-vault indexing.
STRATA_VISION=on

# auto | mtp | dflash2 | off. `auto` uses the drafter the model ships with.
STRATA_DRAFTING=auto

# ---------------------------------------------------------------------------
# Engine tuning
# ---------------------------------------------------------------------------

# Advanced engine settings, space separated, same as `strata launch --set`.
#
# Leave empty for the 0.2.17 defaults. They already include the gfx12 wins:
# matrix-core prompt attention (STRATA_HIP_WMMA), fused IQ3 prompt experts
# (STRATA_PF_FUSED), the exact QSA scorer, 32K prefill chunks, and
# --pcie-frac 0.15.
#
# The one default worth knowing about is the route tail skip (skipping rarely
# used parts of the model). It is OFF in 0.2.17 because it changed answers.
# STRATA_SET="STRATA_ROUTE_TAIL_SKIP=7" turns it back on: faster decode on some
# cards, at the quality cost upstream now declines by default.
#
# Tuning is per (model, box). `TUNE=quick` on a start measures settings once and
# keeps the result in the preset; `TUNE=quick RETUNE=1` tunes again after a
# model or engine change.
STRATA_SET=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Match the box timezone.
TZ=Asia/Shanghai
