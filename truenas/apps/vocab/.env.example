# Dockhand deployment inputs for the `vocab` stack.
#
# In Dockhand, use stack name `vocab` and compose path
# `truenas/apps/vocab/compose.yaml`. Add every value below in the stack
# editor's environment-variable panel. Real .env files are gitignored; do not
# commit one.

# Registry: ghcr.io (private). Register it in Dockhand with username `imulab`
# and a classic personal access token carrying the read:packages scope. The
# image is published by the alfredapps GitHub Actions workflow.

# Pinned image tag. Bump this in Dockhand to deploy a new build. `latest` also
# exists, but a sha- tag keeps deploys reproducible and rollbacks trivial.
VOCAB_IMAGE_TAG=sha-0a27281

# Writable dataset for the SQLite database. Create it first:
#   zfs create puddle/apps/vocab
# then hand it to the container identity:
#   chown -R 100:101 /mnt/puddle/apps/vocab
VOCAB_DATA_PATH=/mnt/puddle/apps/vocab

# Container identity. The image defaults to uid 100 and gid 101; keep these in
# sync with the dataset ownership above.
VOCAB_UID=100
VOCAB_GID=101

# ElevenLabs voice. Alice is a British female default voice. Library voices
# such as Rachel are rejected on the free API plan with HTTP 402.
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# SECRET: set the real value in Dockhand with the key-icon toggle ON. Never put
# the real key in this file or in any committed .env.
ELEVENLABS_API_KEY=set-in-dockhand-stack-env-as-secret

# Host timezone for log timestamps.
TZ=Etc/UTC
