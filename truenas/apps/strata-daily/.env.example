# Dockhand deployment inputs for the `strata-daily` stack.
#
# In Dockhand: stack name `strata-daily`, compose path
# `truenas/apps/strata-daily/compose.yaml`. Add every value below in the stack
# editor's environment-variable panel, then Deploy.
#
# NOTHING IN THIS STACK IS SECRET: leave every key-icon toggle OFF. Dockhand
# injects secrets at deploy time and documents that they vanish on a
# daemon-initiated restart. strata-daily is restart: unless-stopped, so it
# comes back on its own after a reboot - a secret-based value would silently
# disappear exactly then, leaving an endpoint that looks healthy but is
# unauthenticated. Plain env vars are baked into the container at create time
# and survive. Same reasoning as the comfyui stack.
#
# The SHARED values (image build, GPU, storage, access, TZ) must ALSO be set in
# the `strata-coding` stack's env panel. Dockhand stores env vars per stack, so
# the two stacks do not share them; keep the two panels in step.
#
# Kernel note: this stack needs the TrueNAS 26 kernel (6.18). The 25.10 kernel
# (6.12.95) enumerated gfx1201 but wedged on first GPU context (gfx ring test
# -110, "MES ring buffer is full"); the box was upgraded to 26-Beta3 on
# 2026-10-06 and works. Same gate as comfyui.
#
# GPU co-tenancy: no VRAM isolation between ROCm processes. strata-daily,
# strata-coding and comfyui are mutually exclusive - stop one in Dockhand
# before starting another.

# ---------------------------------------------------------------------------
# Image build  (SHARED - set in both stacks)
# ---------------------------------------------------------------------------

# Required, no default. The Strata release tag or commit the engine is built
# from at image build time. Check:
#   https://github.com/Niko1221/Strata/releases
# setup.py enforces MIN_ENGINE = 0.1.40.2, so a ref older than that is refused
# at start. v0.1.40.4 is the conservative fallback if the newest tag
# misbehaves. Bumping this is a rebuild: open the stack in Dockhand and Deploy
# with "build images" enabled.
STRATA_REF=v0.1.41

# Target GPU architecture. gfx1201 is the Radeon AI PRO R9700 (RDNA4).
STRATA_HIP_ARCH=gfx1201

# cpu | none. "cpu" builds the image encoder that runs on the CPU - the AMD
# backend has no GPU image encoder, so this is the only vision path on this
# card. Unlike the NVIDIA path (which reserves ~1.4 GB of VRAM and evicts
# ~1000 expert slots, costing 2-8% on text), the CPU encoder costs NOTHING on
# the GPU, so vision does not slow text down here.
STRATA_BUILD_VISION=cpu

# ---------------------------------------------------------------------------
# GPU devices  (SHARED - set in both stacks)
# ---------------------------------------------------------------------------

# Numeric GID of the host render group, which owns both /dev/kfd and the
# render nodes (root:render, mode 660). Verify on the box:
#   stat -c '%n gid=%g' /dev/kfd /dev/dri/renderD*
# Devices need no env vars: compose maps the whole /dev/dri directory plus
# /dev/kfd directly.
STRATA_RENDER_GID=107

# ---------------------------------------------------------------------------
# Storage  (SHARED - set in both stacks)
# ---------------------------------------------------------------------------

# /data root: config, packs and the MTP draft layer. Lives on puddle and is
# the part worth snapshotting. Created pre-deploy:
#   zfs create -p puddle/apps/strata
#   mkdir -p /mnt/puddle/apps/strata/config
STRATA_DATA_PATH=/mnt/puddle/apps/strata

# The model shards and mmproj files, overlaid onto /data/models from the
# Optane 900P pool. This is the ONE directory that must be on flash: shard 2
# (the -00002-of-00002.gguf, a 28.8 GB n-gram/PLE lookup table) is read from
# disk during inference, not loaded into RAM. Everything else in /data is read
# once at startup into RAM. Created pre-deploy:
#   zpool create -o ashift=12 cistern /dev/disk/by-id/<optane-900p-id>
#   zfs create -p -o recordsize=1m -o atime=off cistern/apps/strata/models
STRATA_MODELS_PATH=/mnt/cistern/apps/strata/models

# ---------------------------------------------------------------------------
# Access  (SHARED - set in both stacks)
# ---------------------------------------------------------------------------

# Direct LAN fallback (Jellyfin/IPMIDeck/ComfyUI pattern). Caddy separately
# serves the canonical route over the external proxy network:
#   https://strata-daily.absurdlab.dev
# which resolves only via the photonicat dnsmasq hijack. Add the hostname in
# Network -> DHCP and DNS -> Hostnames, then refresh Passwall's DNS per
# apps/README.md.
STRATA_BIND_ADDRESS=192.168.20.11

# Host port for the direct LAN fallback. NOT 8080: the TrueNAS web UI already
# owns host 8080 on this box (see dashy/conf.yml, "TrueNAS web UI over HTTP"),
# and Caddy holds 80/443. Strata's container port stays 8080 regardless. Both
# Strata stacks share this host port, which is fine because only one runs at a
# time - and if both ever start, the loser fails fast on the bind instead of
# fighting for the GPU.
# 27182 chosen deliberately: it is below Linux's ephemeral port range
# (32768-60999, see net.ipv4.ip_local_port_range), so Docker's bind can never
# race a transient outbound allocation and fail intermittently at start, and it
# is far from every port in use on this box (8080, 8443, 8096, 2283, 6233,
# 8188, 30328) so a range scan will not stumble onto it.
# Verify before deploying:  ss -lntp | grep -E ':(8080|27182)\b'
STRATA_PUBLISHED_PORT=27182

# No API key here on purpose: the endpoint is bound to the LAN and reached
# over the proxy network, so network placement is the control. If you ever
# expose it beyond the LAN, add API_KEY=<value> to the compose environment as
# a PLAIN env var (not a Dockhand secret - see the header note).

# ---------------------------------------------------------------------------
# Daily driver model
# ---------------------------------------------------------------------------

# Swift 1.5 IQ2_XS: the same architecture as the original at the same speed
# per token, but trained to reach the answer with far less thinking (63% fewer
# thinking tokens, ~1.8x sooner answers, under 1% accuracy loss). For
# interactive home use the wall-clock time is what you feel. Swap to
# FAMILY=qwen for the base model - both are IQ2_XS, and either way the Coder
# reuses the base mmproj. Note Swift ships its OWN vision encoder
# (mmproj-Swift-Qwen3.8-Flash-Next-BF16.gguf), separate from the base model's.
STRATA_DAILY_FAMILY=swift
STRATA_DAILY_MODEL=IQ2_XS

# 65536 is not just "enough": at 64K and above setup keeps the KV cache in RAM
# and only the attention window in VRAM (--kv-resident 32768), which frees
# VRAM for expert slots. Below 64K the KV cache competes with the expert
# cache. Setup accepts 8K-262K.
STRATA_DAILY_CONTEXT=65536

# int8 is setup's default and the safest. k8v4 (INT8 keys, 4-bit values) uses
# 23% less KV than 8-bit and scores better than q4_0 on long documents; q4_0
# halves the KV but costs 8-12% perplexity on long documents.
STRATA_DAILY_KV=int8

# cpu | no. Vision costs nothing on the GPU with the CPU encoder, so leave it
# on for camera frames. Each image becomes up to 1024 context tokens, encoded
# once even when the same picture is re-sent on later turns.
STRATA_DAILY_VISION=cpu

# HARD RAM cap. setup.py reads the HOST's /proc/meminfo (128 GB), not this
# cap, so the cap must EXCEED what setup plans or setup configures a full-RAM
# layout that the cap then OOM-kills. IQ2_XS plans ~45 GB (35.5 GB of experts
# plus ~10 GB), so 64g leaves headroom and still leaves 64 GB of the host for
# TrueNAS, ZFS ARC and the other stacks. Do not convert this to a soft limit.
STRATA_DAILY_MEM_LIMIT=64g

# ---------------------------------------------------------------------------
# Misc  (SHARED - set in both stacks)
# ---------------------------------------------------------------------------

# Match the box timezone.
TZ=Asia/Shanghai
